## Async lifecycle management

- **Implement proper shutdown handling**

  ```rust
  async fn run_server_with_shutdown() -> Result<(), Error> {
      // Create shutdown channel
      let (shutdown_tx, shutdown_rx) = tokio::sync::broadcast::channel::<()>(1);

      // Clone sender for signal handler
      let shutdown_tx_clone = shutdown_tx.clone();

      // Handle Ctrl+C
      tokio::spawn(async move {
          tokio::signal::ctrl_c().await.expect("Failed to listen for ctrl+c");
          println!("Shutdown signal received");
          let _ = shutdown_tx_clone.send(());
      });

      // Start server
      let server = start_server(shutdown_rx).await?;

      // Wait for server to complete
      server.await?;

      // Run shutdown sequence
      println!("Server shut down, running cleanup...");
      cleanup_resources().await?;

      Ok(())
  }

  async fn start_server(mut shutdown_rx: tokio::sync::broadcast::Receiver<()>) -> Result<impl Future<Output = Result<(), Error>>, Error> {
      // Setup server
      let listener = tokio::net::TcpListener::bind("127.0.0.1:8080").await?;
      println!("Server listening on 127.0.0.1:8080");

      // Return server future
      Ok(async move {
          loop {
              tokio::select! {
                  // Accept connections
                  accept_result = listener.accept() => {
                      let (socket, addr) = accept_result?;
                      println!("Accepted connection from {}", addr);

                      // Spawn connection handler
                      tokio::spawn(async move {
                          // Handle connection
                          if let Err(e) = handle_connection(socket).await {
                              eprintln!("Connection error: {}", e);
                          }
                      });
                  }

                  // Shutdown signal
                  _ = shutdown_rx.recv() => {
                      println!("Shutdown signal received by server");
                      break;
                  }
              }
          }

          Ok(())
      })
  }
  ```

- **Use structured concurrency** for task management

  ```rust
  use futures::future::FutureExt;

  async fn run_tasks() -> Result<(), Error> {
      // Create task group
      let task_group = TaskGroup::new();

      // Spawn tasks
      task_group.spawn(task_one());
      task_group.spawn(task_two());
      task_group.spawn(task_three());

      // Wait for all tasks or first error
      task_group.wait().await?;

      Ok(())
  }

  // Simple task group implementation
  struct TaskGroup {
      tasks: Vec<tokio::task::JoinHandle<Result<(), Error>>>,
  }

  impl TaskGroup {
      fn new() -> Self {
          Self {
              tasks: Vec::new(),
          }
      }

      fn spawn<F>(&mut self, future: F)
      where
          F: Future<Output = Result<(), Error>> + Send + 'static,
      {
          let handle = tokio::spawn(future);
          self.tasks.push(handle);
      }

      async fn wait(self) -> Result<(), Error> {
          for task in self.tasks {
              // Propagate errors, ignoring JoinError (task panic)
              if let Ok(result) = task.await {
                  result?;
              }
          }

          Ok(())
      }
  }
  ```

- **Implement graceful resource management**

  ```rust
  struct AsyncResource {
      connection: Connection,
  }

  impl AsyncResource {
      async fn new() -> Result<Self, Error> {
          let connection = Connection::connect("db://example").await?;
          Ok(Self { connection })
      }

      async fn close(self) -> Result<(), Error> {
          // Graceful shutdown for the resource
          self.connection.close().await
      }
  }

  // Using RAII pattern with async cleanup
  struct ManagedResource {
      resource: Option<AsyncResource>,
  }

  impl ManagedResource {
      async fn new() -> Result<Self, Error> {
          let resource = AsyncResource::new().await?;
          Ok(Self { resource: Some(resource) })
      }
  }

  impl Drop for ManagedResource {
      fn drop(&mut self) {
          if let Some(resource) = self.resource.take() {
              // Schedule cleanup in the background
              // Note: This is not ideal as it might not complete
              tokio::spawn(async move {
                  if let Err(e) = resource.close().await {
                      eprintln!("Error closing resource: {}", e);
                  }
              });
          }
      }
  }

  // Better approach: explicit cleanup
  async fn use_resource() -> Result<(), Error> {
      let resource = AsyncResource::new().await?;

      // Use resource
      process_data(&resource).await?;

      // Explicitly clean up
      resource.close().await?;

      Ok(())
  }
  ```

## Testing async code

- **Create effective async tests**

  ```rust
  #[tokio::test]
  async fn test_async_function() -> Result<(), Error> {
      // Arrange
      let client = MockClient::new();
      client.expect_get()
          .with(mockall::predicate::eq("https://example.com"))
          .returning(|_| {
              Ok(MockResponse::new("test response"))
          });

      // Act
      let result = fetch_data(&client, "https://example.com").await?;

      // Assert
      assert_eq!(result, "test response");
      Ok(())
  }
  ```

- **Test timeouts and cancellation**

  ```rust
  #[tokio::test]
  async fn test_timeout_behavior() {
      // Create a future that never completes
      let never_completes = async {
          tokio::time::sleep(Duration::from_secs(100)).await;
          "This should never return"
      };

      // Test that our timeout logic works
      let result = tokio::time::timeout(
          Duration::from_millis(50),
          never_completes
      ).await;

      // Assert we got a timeout error
      assert!(result.is_err());
      assert!(matches!(result, Err(tokio::time::error::Elapsed { .. })));
  }
  ```

- **Use test utilities for async code**

  ```rust
  // Mock for async trait
  #[async_trait]
