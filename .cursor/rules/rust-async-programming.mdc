# Rust Async Programming Guidelines

Asynchronous programming in Rust enables highly concurrent applications without the overhead of threads. These guidelines will help you write efficient, correct, and maintainable async code.

## Understanding async fundamentals

- **Know how the async model works** in Rust

  ```rust
  // An async function returns a Future that must be awaited
  async fn fetch_data(url: &str) -> Result<String, Error> {
      // This code doesn't run until the Future is polled
      let response = client.get(url).send().await?;
      let body = response.text().await?;
      Ok(body)
  }

  // A Future must be executed by a runtime
  async fn main() {
      match fetch_data("https://example.com").await {
          Ok(data) => println!("Received: {}", data),
          Err(e) => eprintln!("Error: {}", e),
      }
  }
  ```

- **Use the right async runtime** for your needs

  ```toml
  # Cargo.toml
  [dependencies]
  # Tokio - full-featured runtime for most use cases
  tokio = { version = "1", features = ["full"] }

  # Alternative: async-std - std-like API
  # async-std = { version = "1", features = ["attributes"] }

  # Alternative: smol - minimal runtime
  # smol = "1.2"
  ```

  ```rust
  // Using Tokio runtime
  #[tokio::main]
  async fn main() {
      // Your async code here
  }

  // Using async-std runtime
  #[async_std::main]
  async fn main() {
      // Your async code here
  }

  // Manual runtime initialization
  fn main() {
      let runtime = tokio::runtime::Runtime::new().unwrap();
      runtime.block_on(async {
          // Your async code here
      });
  }
  ```

- **Understand Future and async/await**

  ```rust
  use std::future::Future;
  use std::pin::Pin;
  use std::task::{Context, Poll};

  // Under the hood, async/await creates state machines
  // This is roughly equivalent to:
  struct MyFuture {
      state: State,
  }

  enum State {
      Start,
      WaitingOnFirst,
      WaitingOnSecond,
      Done,
  }

  impl Future for MyFuture {
      type Output = String;

      fn poll(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
          match self.state {
              State::Start => {
                  // Start first operation
                  self.state = State::WaitingOnFirst;
                  cx.waker().wake_by_ref();
                  Poll::Pending
              }
              State::WaitingOnFirst => {
                  // Check if first operation complete
                  // If not ready: return Poll::Pending
                  // If ready: start second operation
                  self.state = State::WaitingOnSecond;
                  Poll::Pending
              }
              State::WaitingOnSecond => {
                  // Check if second operation complete
                  // If ready:
                  self.state = State::Done;
                  Poll::Ready("result".to_string())
              }
              State::Done => {
                  panic!("Future polled after completion")
              }
          }
      }
  }
  ```

## Structuring async code

- **Keep async functions focused** and compose them

  ```rust
  // Good: Small, focused async functions
  async fn fetch_user(id: UserId) -> Result<User, Error> {
      let url = format!("/users/{}", id);
      let response = client.get(&url).send().await?;
      response.json().await.map_err(Error::from)
  }

  async fn fetch_user_posts(user_id: UserId) -> Result<Vec<Post>, Error> {
      let url = format!("/users/{}/posts", user_id);
      let response = client.get(&url).send().await?;
      response.json().await.map_err(Error::from)
  }

  // Compose smaller functions
  async fn fetch_user_with_posts(id: UserId) -> Result<(User, Vec<Post>), Error> {
      // Fetch in parallel when possible
      let (user, posts) = tokio::join!(
          fetch_user(id),
          fetch_user_posts(id)
      );

      Ok((user?, posts?))
  }
  ```

- **Use appropriate error handling** for async code

  ```rust
  // Option 1: Use the ? operator with async/await
  async fn process_data() -> Result<(), Error> {
      let data = fetch_data().await?;
      let processed = transform_data(data).await?;
      save_data(processed).await?;
      Ok(())
  }

  // Option 2: For more complex flows, handle errors explicitly
  async fn process_with_fallback() -> Result<Data, Error> {
      match primary_data_source().await {
          Ok(data) => Ok(data),
          Err(e) => {
              log::warn!("Primary source failed: {}", e);
              backup_data_source().await
          }
      }
  }
  ```

- **Organize long-running tasks** clearly

  ```rust
  // Good: Structured application with clean lifetime management
  async fn run_app() -> Result<(), Error> {
      // Initialize resources
      let db = connect_to_database().await?;
      let client = create_api_client();

      // Create shared state
      let state = Arc::new(AppState { db, client });

      // Start background tasks with structured concurrency
      let (shutdown_tx, shutdown_rx) = tokio::sync::broadcast::channel(1);

      let worker_handle = {
          let state = state.clone();
          let mut shutdown_rx = shutdown_rx.subscribe();

          tokio::spawn(async move {
              tokio::select! {
                  _ = background_worker(state) => {
                      log::info!("Worker completed");
                  }
                  _ = shutdown_rx.recv() => {
                      log::info!("Worker shutting down");
                  }
              }
          })
      };

      let server_handle = {
          let state = state.clone();
          let mut shutdown_rx = shutdown_rx.subscribe();

          tokio::spawn(async move {
              tokio::select! {
                  result = run_http_server(state) => {
                      if let Err(e) = result {
                          log::error!("Server error: {}", e);
                      }
                  }
                  _ = shutdown_rx.recv() => {
                      log::info!("Server shutting down");
                  }
              }
          })
      };

      // Wait for shutdown signal
      tokio::signal::ctrl_c().await?;
      log::info!("Shutdown signal received");

      // Initiate graceful shutdown
      shutdown_tx.send(())?;

      // Wait for tasks to complete
      let _ = tokio::join!(worker_handle, server_handle);

      // Clean up resources
      state.db.close().await?;

      Ok(())
  }
  ```

## Async patterns and anti-patterns

- **Use parallel execution** when appropriate

  ```rust
  // Sequential execution (slower)
  async fn sequential() -> Result<(), Error> {
      let data1 = fetch_data_1().await?;
      let data2 = fetch_data_2().await?;
      let data3 = fetch_data_3().await?;
      process_all_data(data1, data2, data3).await?;
      Ok(())
  }

  // Parallel execution (faster)
  async fn parallel() -> Result<(), Error> {
      let (result1, result2, result3) = tokio::join!(
          fetch_data_1(),
          fetch_data_2(),
          fetch_data_3()
      );

      let data1 = result1?;
      let data2 = result2?;
      let data3 = result3?;

      process_all_data(data1, data2, data3).await?;
      Ok(())
  }
  ```

- **Avoid blocking the async runtime**

  ```rust
  // BAD: Blocks the async thread
  async fn bad_file_read() -> Result<String, std::io::Error> {
      // This blocks the thread and prevents other tasks from running!
      let content = std::fs::read_to_string("large_file.txt")?;
      Ok(content)
  }

  // GOOD: Use async file operations or spawn_blocking
  async fn good_file_read() -> Result<String, std::io::Error> {
      // Option 1: Use async file operations
      let content = tokio::fs::read_to_string("large_file.txt").await?;

      // Option 2: Or for libraries without async support, use spawn_blocking
      let content = tokio::task::spawn_blocking(|| {
          std::fs::read_to_string("large_file.txt")
      }).await??;

      Ok(content)
  }
  ```

- **Handle cancellation correctly**

  ```rust
  // Use select! for timeouts and cancellation
  async fn fetch_with_timeout(url: &str) -> Result<String, Error> {
      tokio::select! {
          result = fetch_data(url) => result,
          _ = tokio::time::sleep(Duration::from_secs(5)) => {
              Err(Error::Timeout("Request timed out after 5 seconds"))
          }
      }
  }

  // When a task is cancelled, ensure resources are cleaned up
  async fn process_with_cleanup() {
      let temp_file = create_temp_file().await.unwrap();

      // Use Drop guard to ensure cleanup
      struct CleanupGuard {
          path: PathBuf,
      }

      impl Drop for CleanupGuard {
          fn drop(&mut self) {
              // This runs even if the async task is cancelled
              let _ = std::fs::remove_file(&self.path);
          }
      }

      let _guard = CleanupGuard { path: temp_file.path().to_path_buf() };

      // Do work that might be cancelled...
      process_file(&temp_file).await;

      // temp_file will be removed when _guard is dropped
  }
  ```

- **Be cautious with unbounded operations**

  ```rust
  // BAD: Unbounded concurrent requests
  async fn bad_parallel_requests(urls: &[String]) -> Vec<Result<String, Error>> {
      let mut handles = Vec::with_capacity(urls.len());

      // Spawns all tasks at once, could overload system
      for url in urls {
          let url = url.clone();
          handles.push(tokio::spawn(async move {
              client.get(&url).send().await?.text().await
          }));
      }

      // Wait for all to complete
      let mut results = Vec::with_capacity(urls.len());
      for handle in handles {
          results.push(handle.await.unwrap());
      }

      results
  }

  // GOOD: Bounded concurrency
  async fn good_parallel_requests(urls: &[String]) -> Vec<Result<String, Error>> {
      use futures::stream::{StreamExt, TryStreamExt};

      futures::stream::iter(urls)
          .map(|url| {
              let url = url.clone();
              async move {
                  client.get(&url).send().await?.text().await
              }
          })
          .buffer_unordered(10) // Only 10 concurrent requests
          .collect::<Vec<_>>()
          .await
  }
  ```

