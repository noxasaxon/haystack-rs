- **Choose appropriate channels** for communication

  ```rust
  // One-shot channel for single value communication
  async fn fetch_with_cancellation(url: &str) -> Result<String, Error> {
      let (done_tx, done_rx) = tokio::sync::oneshot::channel();

      // Spawn task that can be cancelled
      let fetch_handle = tokio::spawn(async move {
          match fetch_data(url).await {
              Ok(data) => {
                  let _ = done_tx.send(data);
              }
              Err(e) => {
                  log::error!("Fetch error: {}", e);
                  // Channel dropped, receiver will get error
              }
          }
      });

      // Wait for result or cancellation
      tokio::select! {
          result = done_rx => {
              Ok(result?)
          }
          _ = tokio::time::sleep(Duration::from_secs(5)) => {
              // Cancel the operation
              fetch_handle.abort();
              Err(Error::Timeout("Request timed out".into()))
          }
      }
  }

  // MPSC channel for stream processing
  async fn process_stream() -> Result<(), Error> {
      let (tx, mut rx) = tokio::sync::mpsc::channel(100);

      // Producer
      let producer_handle = tokio::spawn(async move {
          for i in 0..1000 {
              if tx.send(i).await.is_err() {
                  break;
              }
              tokio::time::sleep(Duration::from_millis(1)).await;
          }
      });

      // Consumer
      let mut count = 0;
      while let Some(value) = rx.recv().await {
          process_value(value).await?;
          count += 1;
      }

      log::info!("Processed {} values", count);
      Ok(())
  }
  ```

- **Use connection pooling** for shared resources

  ```rust
  use deadpool_postgres::{Config, Pool, Runtime};

  async fn create_db_pool() -> Result<Pool, Error> {
      let mut cfg = Config::new();
      cfg.host = Some("localhost".to_string());
      cfg.dbname = Some("mydatabase".to_string());
      cfg.user = Some("user".to_string());
      cfg.password = Some("password".to_string());

      // Create pool with connection limit
      let pool = cfg.create_pool(Some(Runtime::Tokio1), tokio_postgres::NoTls)?;

      Ok(pool)
  }

  async fn use_connection_pool(pool: &Pool) -> Result<(), Error> {
      // Get connection from pool
      let conn = pool.get().await?;

      // Use connection for query
      let rows = conn.query("SELECT * FROM users", &[]).await?;

      // Connection returned to pool when conn is dropped
      Ok(())
  }
  ```

## Common mistakes

- **Forgetting to poll futures**: Creating async functions but never awaiting them
- **Blocking the runtime**: Running CPU-intensive or blocking I/O on the async runtime
- **Holding locks across await points**: Creating deadlocks by not releasing locks before suspension
- **Unbounded concurrency**: Spawning unlimited tasks without backpressure or limits
- **Nested async blocks**: Creating overly complex future chains that are hard to understand
- **Async main without runtime**: Using async/await without initializing a runtime
- **Improper error propagation**: Not handling errors correctly in async chains
- **Ignoring cancellation**: Not designing for task cancellation and resource cleanup
- **Future combinators overuse**: Using too many combinators instead of clear async/await
- **Non-Send types across await points**: Causing compiler errors by suspending with non-Send data

